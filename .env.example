CLOUDINARY_CLOUD_NAME=sbj4xmfv
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@sbj4xmfv

# Neon Postgres connection string. Required by the API (local server and the
# Vercel functions). Get it from the Neon dashboard -> Connection Details.
# Set it here for local dev, and in the Vercel project's Environment Variables
# for production. Then run: npm run db:migrate
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-south-1.aws.neon.tech/neondb?sslmode=require

# Only needed if the API is hosted somewhere other than the site itself.
# Leave unset: production uses the same origin (/api), local dev uses port 5175.
# VITE_API_BASE=
